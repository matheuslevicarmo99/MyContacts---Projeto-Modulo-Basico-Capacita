<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mycontacts.controller.AgendaController" stylesheets="@style.css" styleClass="fundo-pastel">

    <Label text="MyContacts - Agenda" styleClass="titulo"/>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtNome" promptText="Nome" styleClass="campo-texto" />
        <TextField fx:id="txtTelefone" promptText="Telefone" styleClass="campo-texto" />
        <TextField fx:id="txtEmail" promptText="E-mail" styleClass="campo-texto" />
        <TextField fx:id="txtEmpresa" promptText="Empresa (Comercial)" styleClass="campo-texto" />
        <Button text="Adicionar" onAction="#adicionarContato" styleClass="btn-adicionar"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtBusca" promptText="Buscar por nome..." prefWidth="250" styleClass="campo-texto" />
        <Button text="Buscar" onAction="#buscarContato" styleClass="btn-buscar"/>
        <Button text="Mostrar Todos" onAction="#carregarContatos" styleClass="btn-neutro"/>
        <Button text="Remover Selecionado" onAction="#removerContato" styleClass="btn-remover"/>
    </HBox>

    <TableView fx:id="tabelaContatos" VBox.vgrow="ALWAYS" styleClass="tabela-estilizada">
        <columns>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="150" />
            <TableColumn fx:id="colTelefone" text="Telefone" prefWidth="120" />
            <TableColumn fx:id="colEmail" text="E-mail" prefWidth="200" />
        </columns>
    </TableView>
</VBox>