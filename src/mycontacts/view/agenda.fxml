<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mycontacts.controller.AgendaController" style="-fx-padding: 20px;">

    <Label text="MyContacts - Agenda" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtNome" promptText="Nome" />
        <TextField fx:id="txtTelefone" promptText="Telefone" />
        <TextField fx:id="txtEmail" promptText="E-mail" />
        <TextField fx:id="txtEmpresa" promptText="Empresa (Comercial)" />
        <Button text="Adicionar" onAction="#adicionarContato" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="tabelaContatos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="150" />
            <TableColumn fx:id="colTelefone" text="Telefone" prefWidth="120" />
            <TableColumn fx:id="colEmail" text="E-mail" prefWidth="200" />
        </columns>
    </TableView>
</VBox>